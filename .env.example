# Example environment variables for Digital Transformation Compliance Auditor.
# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here

# Models
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# RAG
RAG_TOP_K=4
MAX_CHUNK_WORDS=120

# Compliance evidence "current year" check (used to flag outdated screenshots)
CURRENT_COMPLIANCE_YEAR=2026

# Security: authentication / RBAC (see src/security/auth.py).
# Keep true in any shared/deployed environment; set to false only for
# pure local single-operator development.
AUTH_ENABLED=true

# Security: per-session rate limits (see src/security/rate_limit.py)
AUDIT_RATE_LIMIT_MAX=10
AUDIT_RATE_LIMIT_WINDOW_SECONDS=300
IMAGE_RATE_LIMIT_MAX=20
IMAGE_RATE_LIMIT_WINDOW_SECONDS=300
